ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TAG
# Default base image 
ARG BASE_IMAGE=ubuntu
# Default release is 26.04
ARG BASE_IMAGE_RELEASE=26.04




# install all nodejs modules
# build nodejs module
# create /composer/node
# use FROM BASE_IMAGE
# define FROM before use ENV command
FROM ${BASE_IMAGE}:${BASE_IMAGE_RELEASE} AS ubuntu_node_modules_builder

# use bash
SHELL ["/bin/bash", "-c"]

# define arg
ARG TARGET_MODE
ARG TARGET_PRUNE
# convert ARG to ENV with same name
ENV TARGET_MODE=$TARGET_MODE
ENV TARGET_PRUNE=$TARGET_PRUNE
ENV NODE_MAJOR=24

RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections
RUN apt-get update && apt-get install -y  --no-install-recommends \
        gcc \
        g++ \
        make                        

# to make install wmctrljs nodejs components
# add build dev package 
RUN apt-get update && apt-get install -y  --no-install-recommends \
        ca-certificates \
        libx11-dev \
        libxmu-dev \
	libimlib2-dev \
        git \
        curl \
        gnupg \
        dpkg

# install nodejs
RUN curl -fsSL https://deb.nodesource.com/setup_24.x -o nodesource_setup.sh && \
    bash nodesource_setup.sh && rm nodesource_setup.sh && \
    apt install nodejs -y
    

COPY composer /composer

RUN npm install --global node-gyp
RUN echo target_prune="$TARGET_PRUNE"
RUN if [ -z "$TARGET_PRUNE" ] ; then echo "TARGET_PRUNE is not defined, build with dev" ; else echo "TARGET_PRUNE is defined, NO DEV options" ; fi

# add wait-port
WORKDIR /composer/node/wait-port 
RUN npm install --omit=dev && npm audit fix

WORKDIR /composer/node/broadcast-service
RUN if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi
RUN npm i --package-lock-only && npm audit fix --omit=dev

RUN git clone https://github.com/abcdesktopio/run-service.git /composer/node/ocrun 
WORKDIR /composer/node/ocrun
RUN if [ ! -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi
RUN cp ocrun.js ocrun.builtin.js    && sed -Ei 's/^let DEFAULT_EXECMODE;/let DEFAULT_EXECMODE="builtin";/'    ocrun.builtin.js 
RUN cp ocrun.js ocrun.frontendjs.js && sed -Ei 's/^let DEFAULT_EXECMODE;/let DEFAULT_EXECMODE="frontendjs";/' ocrun.frontendjs.js    
RUN npm i --package-lock-only && npm audit fix --omit=dev

WORKDIR /composer/node/ocdownload
RUN if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi
RUN npm audit fix --omit=dev

WORKDIR /composer/node/occall
RUN if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi
RUN npm audit fix --omit=dev

# RUN git clone https://github.com/abcdesktopio/colorflow.git /composer/node/spawner-service/lib_spawner/colorflow
# WORKDIR /composer/node/spawner-service/lib_spawner/colorflow
# RUN if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; npm run build;  fi
# RUN rm colorflow.test.js && rm -rf images/

WORKDIR /composer/node/spawner-service
# install node-gyp to build spawner-service
RUN if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi
# RUN npm audit fix --omit=dev


WORKDIR /
RUN if [ "$TARGET_MODE" = "hardening" ] ; then \
        rm -rf /composer/node/xterm.js; \
    else \
        cd /composer/node/xterm.js ;\
	if [ -z "$TARGET_PRUNE" ] ; then npm install ; else npm install --omit=dev; fi ;\ 
    fi

# version.json must be created by mkversion.sh bash script
COPY composer/version.json /composer/version.json

# rofi theme
FROM ${BASE_IMAGE}:${BASE_IMAGE_RELEASE} AS ubuntu_rofi_themes__builder 
RUN apt-get update
RUN apt-get install -y git
RUN git clone https://github.com/lr-tech/rofi-themes-collection.git


FROM ${BASE_IMAGE}:${BASE_IMAGE_RELEASE} AS ubuntu_waybar_builder
RUN apt-get update
RUN apt-get install -y git cmake   meson   scdoc   wayland-protocols libxml2-utils
RUN apt-get install -y clang-tidy gobject-introspection libdbusmenu-gtk3-dev libevdev-dev   libfmt-dev libgirepository1.0-dev libgtk-3-dev libgtkmm-3.0-dev   libinput-dev libjsoncpp-dev libmpdclient-dev libnl-3-dev libnl-genl-3-dev   libpulse-dev libsigc++-2.0-dev libspdlog-dev libwayland-dev scdoc upower   libxkbregistry-dev wayland-protocols
RUN git clone https://github.com/Alexays/Waybar
RUN cd Waybar && meson setup build
RUN cd Waybar && ninja -C build




## Buid wayvnc 
FROM ${BASE_IMAGE}:${BASE_IMAGE_RELEASE} AS ubuntu_wayvnc_builder
# get packages to build
RUN apt-get update
RUN apt-get install -y build-essential automake
RUN apt install -y meson libdrm-dev libxkbcommon-dev libjansson-dev \
        libpam0g-dev libgnutls28-dev libavfilter-dev libavcodec-dev \
        libavutil-dev libturbojpeg0-dev scdoc
RUN apt-get install -y libwlroots-0.19-dev || true 
RUN apt-get install -y libpixman-1-dev || true
RUN apt-get install -y libpixman-1-0 || true
RUN apt-get install -y libwlroots-dev || true

# clone source code
RUN apt-get install -y git wget
RUN wget https://github.com/any1/neatvnc/archive/refs/tags/v1.0.2.tar.gz && tar -xvf v1.0.2.tar.gz && mv neatvnc-1.0.2 neatvnc
RUN wget https://github.com/any1/aml/archive/refs/tags/v1.0.0.tar.gz && tar -xvf v1.0.0.tar.gz && mv aml-1.0.0 aml
RUN wget https://github.com/any1/wayvnc/archive/refs/tags/v0.10.2.tar.gz && tar -xvf v0.10.2.tar.gz && mv wayvnc-0.10.2 wayvnc
# RUN git clone https://github.com/any1/neatvnc.git
# RUN git clone https://github.com/any1/aml
# RUN git clone https://github.com/any1/wayvnc
# COPY src/wayvnc-0.10.2 /wayvnc
# build 
RUN mkdir -p wayvnc/subprojects
RUN cd wayvnc/subprojects && ln -s ../../neatvnc . || true
RUN cd wayvnc/subprojects && ln -s ../../aml . || true
RUN mkdir -p neatvnc/subprojects
RUN cd neatvnc/subprojects && ln -s ../../aml . || true
RUN cd wayvnc && meson build && ninja -C build
# test
RUN cd wayvnc && meson test -C build
RUN mkdir /install
RUN cd wayvnc && DESTDIR=/install ninja -C build install


## build sfwbar
FROM  ${BASE_IMAGE}:${BASE_IMAGE_RELEASE} AS ubuntu_sfwbar_builder

## Buid sfwbar
RUN apt-get update && apt-get install -y build-essential automake ninja-build meson git gettext
RUN apt install -y libgtk-3-dev libgtk-layer-shell-dev libjson-c-dev 
RUN apt install -y libpulse-dev libasound2-dev libmpdclient-dev 
RUN apt install -y libwayland-dev wayland-protocols libgtk-layer-shell-dev 
RUN apt install -y bluez libbluetooth-dev libasound2-dev libxkbregistry-dev wayland-protocols gettext

# clone source code
RUN git clone https://github.com/LBCrion/sfwbar
# meson setup build --werror -Dpulse=enabled -Dmpd=disabled -Dnetwork=enabled -Dalsa=disabled -Dbluez=disabled -Dxkb=enabled -Didleinhibit=disabled
RUN cd sfwbar && meson setup build
RUN cd sfwbar && ninja -C build
RUN mkdir /install
RUN cd sfwbar && DESTDIR=/install ninja -C build install


#
# The main oc.user start here
#
FROM ${BASE_IMAGE}:${BASE_IMAGE_RELEASE}

# use bash
SHELL ["/bin/bash", "-c"]

# define arg
ARG ABCDESKTOP_LOCALACCOUNT_DIR
ARG TARGET_MODE
# convert ARG to ENV with same name
ENV ABCDESKTOP_LOCALACCOUNT_DIR=$ABCDESKTOP_LOCALACCOUNT_DIR
ENV TARGET_MODE=$TARGET_MODE
# set node release
ENV NODE_MAJOR=24

COPY etc /etc
RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections && \
    apt-get update  && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        net-tools \
        bash && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# add languages 
# locales for locale-gen command
RUN apt-get update && apt-get install -y --no-install-recommends \
	locales \
        language-pack-en \
        language-pack-fr \
        language-pack-de \
        && locale-gen \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

# a good example is 
# RUN apt-get update && apt-get install -y locales && rm -rf /var/lib/apt/lists/* \
#	&& localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8
# ENV LANG en_US.utf8

# install
# Do not use 
# COPY tigervncserver_1.13.1-1ubuntu1_amd64.deb /tmp to install
# tigervncserver_1.13.1-1ubuntu1_amd64.deb
# tigervncserver_1.13.1-1ubuntu1_arm64.deb    
# but replace by curl command to support dpkg --print-architecture for amd64 and arm64
# tigervncserver_1.14.80-1ubuntu1_22.04_amd64.deb
# tigervncserver_1.14.1-1ubuntu1_22.04.amd64.deb
# tigervncserver_1.14.1-1ubuntu1_24.04.amd64.deb
# ENV TIGERVNC_RELEASE=1.16.2
# RUN apt-get update  && \
#    source /etc/lsb-release && \
#    echo DISTRIB_RELEASE=${DISTRIB_RELEASE} && \
#    tigervncdeburl="https://github.com/abcdesktopio/oc.user/raw/4.4/tigervncserver_${TIGERVNC_RELEASE}-1ubuntu1_${DISTRIB_RELEASE}_$(dpkg --print-architecture).deb" && \
#    echo Downloading $tigervncdeburl && \
#    curl -sL --output /tmp/tigervncserver.deb "$tigervncdeburl" && \  
#    apt-get install -y --no-install-recommends /tmp/tigervncserver.deb && \
#    rm -f /tmp/*.deb && \
#    apt-get clean && rm -rf /var/lib/apt/lists/* 

# install core packages
# x11-apps is need to install xeyes xeyes is a test application
# sfwbar need librsvg2-common librsvg2-bin to paint svg icon
RUN apt-get update && \    
    apt-get install -y --no-install-recommends \
        supervisor \
        libnss-extrausers \
        cups-client \
        pulseaudio-utils \
        xauth \
        krb5-user \
        xdg-user-dirs \
        dbus-x11 \
        xdg-utils \
        desktop-file-utils \
        labwc \
        waybar \ 
	librsvg2-common \
	librsvg2-bin \
        websockify \
        swaybg \
        xwayland \
        rofi \
        gettext-base \
    && apt-get clean && rm -rf /var/lib/apt/lists/*


# note the packages :
# - xdg-desktop-portal
# - xdg-desktop-portal-gtk
# xdg-desktop-portal \
# xdg-desktop-portal-gtk \
# are not required but need for w0vncserver for tigervnc 
# if you want to replace wayvnc by w0vncserver
# RUN apt-get update && \
#    apt-get install -y --no-install-recommends \
#      dbus-x11 \
#      xdg-utils \
#      desktop-file-utils \
#    && apt-get clean && rm -rf /var/lib/apt/lists/*

# install themes
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
	papirus-icon-theme \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# libimlib2 for colorflow
# RUN apt-get update && \
#    apt-get install -y --no-install-recommends \
#        libimlib2 \
#    && apt-get clean && rm -rf /var/lib/apt/lists/*

# install lib for wayvnc in ubuntu 24.04
# RUN apt-get update && \
#    apt-get install -y --no-install-recommends \
#        libdrm2 \
#        libxkbcommon0 \
#        libwlroots12t64 \
#        libjansson4 \
#        libpam0g \
#        libavfilter9 \
#        libavcodec60 \
#        libavutil58 \
#        libturbojpeg \
#    && apt-get clean && rm -rf /var/lib/apt/lists/*


# install lib for wayvnc in ubuntu 26.04
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libjansson4 \
        libdrm2 \
        libxkbcommon0 \
        libwlroots-0.19 \
        libjansson4 \
        libpam0g \
        libavfilter11 \
        libavcodec62 \
        libavutil60 \
        libturbojpeg0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# install lib for sfwbar in ubuntu 26.04
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
	libjson-c5 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# install wayvnc
# COPY --from=ubuntu_wayvnc_builder /wayvnc/build/wayvnc /usr/local/bin/wayvnc
# COPY --from=ubuntu_wayvnc_builder /wayvnc/build/wayvncctl /usr/local/bin/wayvncctl
# COPY --from=ubuntu_wayvnc_builder /wayvnc/build/subprojects/aml/libaml.so /usr/lib/x86_64-linux-gnu/libaml.so
# COPY --from=ubuntu_wayvnc_builder /wayvnc/build/subprojects/neatvnc/libneatvnc.so /usr/lib/x86_64-linux-gnu/libneatvnc.so

# install wayvnc
COPY --from=ubuntu_wayvnc_builder /install/usr/local/ /usr/local/


# RUN apt-get update && \
#    apt-get install -y --no-install-recommends \
#        wayvnc \
#    && apt-get clean && rm -rf /var/lib/apt/lists/*

# install sfwbar
COPY --from=ubuntu_sfwbar_builder /install/usr/local/ /usr/local/

# install rofi theme
COPY --from=ubuntu_rofi_themes__builder /rofi-themes-collection/themes/ /usr/local/share/rofi/themes/

# install composer
COPY --from=ubuntu_node_modules_builder /composer /composer

# install waybar
# COPY --from=ubuntu_waybar_builder /Waybar/build/waybar /usr/local/bin/waybar
 
RUN if [ "$TARGET_MODE" = "hardening" ] ; then  dpkg -L libkf5su5 | /composer/rmfol.sh; fi && \    
    if [ "$TARGET_MODE" = "hardening" ] ; then  dpkg -L sudo      | /composer/rmfol.sh; fi 


ENV BUSER=balloon
RUN groupadd --gid 4096 $BUSER && \
    useradd --create-home --shell /bin/bash --uid 4096 -g $BUSER $BUSER && \
    echo "balloon:lmdpocpetit" | chpasswd $BUSER &&\
    chown -R $BUSER:$BUSER /home/$BUSER


# for gamepad
#  python3-libevdev \
#  libevdev2 
#  libevdev-tools
# RUN apt-get update && \
#     apt-get install -y --no-install-recommends \
#       python3-uinput \
#       python3-websockets \
#       jstest-gtk && \
#     apt-get clean && rm -rf /var/lib/apt/lists/*


# RUN apt-get update && \
#    apt-get install -y --no-install-recommends \
#        python3-uinput \
#	python3-websockets \
#	jstest-gtk && \
#    apt-get clean && rm -rf /var/lib/apt/lists/*


## install MS fonts 
## replace by install Selawik fonts this one is free
#RUN apt-get update && \
#    echo ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true | sudo debconf-set-selections
#    apt-get install -y --no-install-recommends fontconfig ttf-mscorefonts-installer && \
#    apt-get clean && rm -rf /var/lib/apt/lists/*


# install Selawik and JetBrainsMono fonts
# comment for licencing
# ADD fonts/SegoeUI.tar /usr/share/fonts/Microsoft/TrueType/SegoeUI/ 
#  fc-cache -f /usr/share/fonts/Microsoft/TrueType/SegoeUI/ && \
# mkdir -p /usr/share/fonts/NerdFonts/JetBrainsMono && \
#    curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/JetBrainsMono.tar.xz -o /tmp/JetBrainsMono.tar.xz && \
#    tar -xJf /tmp/JetBrainsMono.tar.xz -C /usr/share/fonts/NerdFonts/JetBrainsMono && \
#    rm -f /tmp/JetBrainsMono.tar.xz && \
#    fc-cache -f /usr/share/fonts/NerdFonts/JetBrainsMono 
ADD fonts/Selawik.tar /usr/share/fonts/Microsoft/TrueType/Selawik/
# ADD fonts/JetBrainsMono.tar /usr/share/fonts/NerdFonts/JetBrainsMono/ 
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
	fontconfig \
	fonts-noto \
	fonts-font-awesome \
	xfonts-base && \
    curl -fsSL https://raw.githubusercontent.com/JetBrains/JetBrainsMono/master/install_manual.sh && \
    chmod 755 install_manual.sh && \
    ./install_manual.sh && \
    rm install_manual.sh && \
    fc-cache -f /usr/share/fonts/Microsoft/TrueType/Selawik/ /usr/share/fonts/NerdFonts/JetBrainsMono/ && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Add usr/share/themes/Windows-10 themes 
COPY usr/share/themes/Windows-10 /usr/share/themes/Windows-10
COPY usr/share/themes/Lab-W11 /usr/share/themes/Lab-W11
COPY usr/share/aurorae /usr/share/aurorae

# https://github.com/yeyushengfan258/Win11OS-kde
# https://github.com/abcdesktopio/Win11OS-kde

# install Win11-icon theme and Win11OS-kde theme
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    git clone https://github.com/abcdesktopio/Win11-icon-theme && \
    cd Win11-icon-theme && ./install.sh > /composer/Win11-icon-theme.install && cd .. && \
    rm -rf Win11-icon-theme && \
    git clone https://github.com/abcdesktopio/Win11OS-kde && \
    cd Win11OS-kde && ./install.sh > /composer/Win11OS-kde.install && cd .. && \
    rm -rf Win11OS-kde && \
    apt-get remove -y git git-man liberror-perl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# create a link to Win11OS-light wallpaper in /composer/wallpapers
RUN cp /usr/share/wallpapers/Win11OS-light/contents/images/3840x2400.jpg /composer/wallpapers/Win11OS-light.jpg

# add breeze theme
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
	breeze-gtk-theme && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* 

# install nodejs
RUN curl -fsSL https://deb.nodesource.com/setup_24.x -o nodesource_setup.sh && \
    bash nodesource_setup.sh && rm nodesource_setup.sh && \
    apt install -y nodejs --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# add sound files from ubuntu alsa package alsa-utils
ADD usr/share/sounds/alsa /usr/share/sounds/alsa

# RUN chmod -R 755 /usr/share/plasma/desktoptheme/Win11OS-light/*
# LOG AND PID SECTION
RUN mkdir -p /var/log/desktop /var/run/desktop && \
    chmod 777 /var/log/desktop /var/run/desktop 

# remove /etc/supervisor/conf.d/xterm.conf in hardening
RUN if [ "$TARGET_MODE" = "hardening" ] ; then \
	rm -f /etc/supervisor/conf.d/xterm.conf; \
	echo "supervisor xterm.conf has been removed"; \
    fi

# set build date
RUN date > /etc/build.date
# install foot
RUN if [ "${TARGET_MODE}" != "hardening" ]; then \
	apt-get update && \
	apt-get install -y --no-install-recommends foot vim-gtk3 && \
	apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

# remove bad cache mime entries
RUN rm -f /usr/share/applications/mimeinfo.cache

# fun but not a good idea
# RUN if [ "$TARGET_MODE" = "hardening" ] ; then \
#        apt-get remove -y --allow-remove-essential apt && \
#        rm -rf /var/lib/dpkg /bin/dpkg* /sbin/dpkg-* /var/log/apt /var/log/*.log /etc/apt ; \
#    fi


# Make all NVIDIA GPUs visible by default
ENV NVIDIA_VISIBLE_DEVICES=all
# All NVIDIA driver capabilities should preferably be used, check `NVIDIA_DRIVER_CAPABILITIES` inside the container if things do not work
ENV NVIDIA_DRIVER_CAPABILITIES=all

# set command
CMD [ "/composer/docker-entrypoint.sh" ]

####################################################
# SERVICE                           #   TCP PORT   #
####################################################
# XTERM_TCP_PORT                        29781
# BROADCAST_SERVICE_TCP_PORT            29784
# SPAWNER_SERVICE_TCP_PORT              29786
# WS_TCP_BRIDGE_SERVICE_TCP_PORT         6081
# DBUS_SESSION_TCP_PORT                 55556
# DBUS_SYSTEM_TCP_PORT                  55557
####################################################

## RESERVED TCP PORT 29782 for pulseaudio
## RESERVED TCP PORT 29785 for cupsd
EXPOSE 6081 29781 29784 29786
