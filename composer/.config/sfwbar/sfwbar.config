# Configuration sfwbar - Style Windows 11 pour labwc

DisownMinimized = true
Set Term = "foot"

Function("SfwbarInit") {
  SetLayer "top"
  SetBarSize "100%"
  SetMirror "*"
}

include("winops.widget")

layout {
  css = "* { min-height: 45px; font-family: 'Ubuntu', 'Sans', sans-serif; font-size: 14px; }"

  include("startmenu.widget")

  taskbar {
    group = true
    group cols = 1
    group labels = true
    group icons = true
    style = "taskbar_w11"
    rows = 1
    icons = true
    labels = false
    sort = false
    action = Menu "winops"
  }

  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  tray {
    rows = 1
    style = "tray_w11"
  }

  grid {
    style = "status_w11"
    include("pulse-module.widget")
    include("network-module.widget")
    include("battery-svg.widget")
  }

  grid {
    style = "clock_w11"
    label {
      value = Time("%k:%M")
      style = "clock_time"
    }
    label {
      value = Time("%d/%m/%Y")
      style = "clock_date"
    }
  }
}

#CSS

window#sfwbar {
  background: rgba(243, 243, 243, 0.85);
}

button, button image {
  outline-style: none;
  box-shadow: none;
  background-image: none;
}

button#startmenu {
  padding: 0px 12px;
  margin: 4px;
}

grid#taskbar_w11 {
  -GtkWidget-halign: center;
}

button#taskbar_normal,
button#taskbar_active,
button#taskbar_normal:hover {
  margin: 4px 3px;
  padding: 4px 12px;
  border-radius: 4px;
  border-bottom: 3px solid transparent;
}

button#taskbar_normal {
  border-bottom: 3px solid #858585;
}

button#taskbar_normal:hover {
  background-color: rgba(0, 0, 0, 0.05);
  border-bottom: 3px solid #0067b8;
}

button#taskbar_active {
  background-color: rgba(255, 255, 255, 0.6);
  border-bottom: 3px solid #0067b8;
}

button#taskbar_normal image,
button#taskbar_active image {
  min-width: 24px;
  min-height: 24px;
}

grid#status_w11, grid#tray_w11 {
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 6px;
  margin: 4px 4px;
  padding: 0px 8px;
}

button#module image, button#tray_active image, button#tray_passive image {
  min-width: 16px;
  min-height: 16px;
  padding: 4px;
}

grid#clock_w11 {
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 6px;
  margin: 4px 8px 4px 4px;
  padding: 4px 10px;
  -GtkWidget-direction: bottom;
}

label#clock_time {
  font-weight: bold;
  font-size: 12px;
  color: #202020;
}

label#clock_date {
  font-size: 10px;
  color: #616161;
}

#hidden {
  -GtkWidget-visible: false;
}
